menu "Example Configuration"

    config EXAMPLE_ENABLE_MIPI_CSI_CAM_SENSOR
        bool "Enable MIPI CSI Camera Sensor"
        default y
        depends on SOC_MIPI_CSI_SUPPORTED

    if EXAMPLE_ENABLE_MIPI_CSI_CAM_SENSOR
        config EXAMPLE_MIPI_CSI_SCCB_I2C_PORT
            int "MIPI CSI SCCB I2C Port Number"
            default 0
            range 0 1

        config EXAMPLE_MIPI_CSI_SCCB_I2C_SCL_PIN
            int "MIPI CSI SCCB I2C SCL Pin"
            default 34
            range -1 56

        config EXAMPLE_MIPI_CSI_SCCB_I2C_SDA_PIN
            int "MIPI CSI SCCB I2C SDA Pin"
            default 31
            range -1 56

        config EXAMPLE_MIPI_CSI_SCCB_I2C_FREQ
            int "MIPI CSI SCCB I2C Frequency"
            default 100000
            range 100000 400000
            help
                Increasing this value can reduce the initialization time of the camera sensor.
                Please refer to the relevant instructions of the camera sensor to adjust the value.

        config EXAMPLE_MIPI_CSI_CAM_SENSOR_RESET_PIN
            int "MIPI CSI Camera Sensor Reset Pin"
            default -1
            range -1 56

        config EXAMPLE_MIPI_CSI_CAM_SENSOR_PWDN_PIN
            int "MIPI CSI Camera Sensor Power Down Pin"
            default -1
            range -1 56
    endif

    config EXAMPLE_ENABLE_PRINT_FPS_RATE_VALUE
        bool "enable print fps rate value"
        default y

    config EXAMPLE_ENABLE_LCD_FPS_OVERLAY
        bool "Show FPS readout on the LCD (RGB565 only)"
        default y
        depends on LCD_PIXEL_FORMAT_RGB565
        help
            Draw a "FPS: 30.1" counter in the top-left corner of the live
            camera image. The value is recalculated every 500 ms and drawn
            into the frame buffer after the PPA blit, before the buffer is
            sent to the DSI panel.

    config EXAMPLE_USE_MEMORY_MAPPING
        bool "Use Memory Mapping for Buffer Allocation"
        default n
        help
        Enable this option if you want to allocate memory using memory mapping.
        This is typically useful for performance optimization or when working
        with hardware that requires mapped memory access

    config EXAMPLE_CAM_BUF_COUNT
        int "Camera Buffer Count"
        default 2
        range 2 3

    choice
        prompt "Choose the color format of the LCD"
        default LCD_PIXEL_FORMAT_RGB565
            config LCD_PIXEL_FORMAT_RGB565
                bool "RGB565"

            config LCD_PIXEL_FORMAT_RGB888
                bool "RGB888"
    endchoice

    config EXAMPLE_ENABLE_CAM_SENSOR_PIC_VFLIP
        bool "Enable Camera Sensor Picture Vertical Flip"
        default n
        help
            Select this option, enable camera sensor picture vertical flip.

    config EXAMPLE_ENABLE_CAM_SENSOR_PIC_HFLIP
        bool "Enable Camera Sensor Picture Horizontal Flip"
        default n
        help
            Select this option, enable camera sensor picture horizontal flip.

    config EXAMPLE_CAM_TEST_PATTERN
        int "Camera Sensor Test Pattern (0=off, 1..4)"
        default 0
        range 0 4
        help
            Overlay a sensor-generated test pattern instead of the live image.
            Useful to verify the whole camera pipeline (MIPI-CSI, ISP, PPA, LCD)
            without optics. Types follow the Linux kernel ov02c10 driver:
              0 - disabled (live image)
              1 - Color Bar
              2 - Top-Bottom Darker Color Bar
              3 - Right-Left Darker Color Bar
              4 - Color Bar type 4
            The pattern is applied right after the video device is opened,
            before the stream starts.

    config EXAMPLE_CAM_TARGET_FPS
        int "Camera Frame Rate Override in fps (0=sensor mode default)"
        default 0
        range 0 30
        help
            Lower the camera frame rate below the sensor mode default (30 fps)
            by increasing the vertical blanking (VTS registers 0x380e/0x380f).
            Useful to allow longer maximum exposure in low light: the AE loop
            can then integrate more light per frame. 0 keeps the sensor mode
            default. The value cannot exceed the mode default because the MIPI
            timing is dimensioned for it. Approximate result:
            fps = pclk / (hts * vts).

    choice EXAMPLE_CAM_DISPLAY_FIT
        prompt "Camera to LCD display fit mode"
        default EXAMPLE_CAM_DISPLAY_FIT_CROP
        help
            How the camera frame is mapped onto the 1024x600 LCD by the PPA.

        config EXAMPLE_CAM_DISPLAY_FIT_CROP
            bool "Crop center, 1:1 pixels"
            help
                Take a centered LCD-sized block from the camera frame without
                scaling. Sharpest possible image; part of the frame outside
                the LCD aspect ratio is not shown.

        config EXAMPLE_CAM_DISPLAY_FIT_SCALE
            bool "Scale to fit (letterbox)"
            help
                Scale the whole camera frame down to fit inside the LCD,
                preserving the aspect ratio. Black bars are added where needed.
                PPA scaling granularity is 1/16, e.g. 1920x1080 -> 960x540.
    endchoice

endmenu

menu "Example Boards Types"

    choice
        prompt "Choose the Boards Types"
        default BOARD_TYPE_JC4880P443
            config BOARD_TYPE_JC4880P443
                bool "JC4880P4433"

            config BOARD_TYPE_JC8012P4A1
                bool "JC8012P4A1"
            config BOARD_TYPE_JC1060P470
                bool "JC1060P470"
    endchoice

endmenu
