menu "Example Configuration"

    config EXAMPLE_QUIET_LOGS
        bool "Quiet logs (force INFO level at boot)"
        default y
        help
            Force the runtime log level to INFO at the very start of app_main,
            regardless of what CONFIG_LOG_DEFAULT_LEVEL ended up in a stale
            sdkconfig. Excessive per-event DEBUG logging saturates the 115200
            baud console and slows everything down. sdkconfig.defaults alone is
            not enough: it is only applied when sdkconfig is regenerated.
            Disable only for deep diagnostics with a fast console.

    choice
        prompt "Choose the color format of the LCD"
        default LCD_PIXEL_FORMAT_RGB565
            config LCD_PIXEL_FORMAT_RGB565
                bool "RGB565"

            config LCD_PIXEL_FORMAT_RGB888
                bool "RGB888"
    endchoice

endmenu

menu "CamBrowser (Ethernet Browser on LCD)"

    config EB_ETH_MDC_GPIO
        int "IP101 SMI MDC GPIO"
        default 31
        help
            Fixed by the board schematic (JP1 header, IP101 pin 22).

    config EB_ETH_MDIO_GPIO
        int "IP101 SMI MDIO GPIO"
        default 52
        help
            Fixed by the board schematic (JP1 header, IP101 pin 23).

    config EB_ETH_RMII_CLK_GPIO
        int "RMII REF_CLK GPIO (50 MHz input from the PHY)"
        default 50
        help
            The IP101 generates 50 MHz from its own 25 MHz crystal and
            feeds the ESP32-P4 EMAC on this pin, so the EMAC must run in
            EMAC_CLK_EXT_IN mode (hardcoded in app_eth.c).

    config EB_ETH_RST_GPIO
        int "IP101 reset GPIO (active low, -1 = none)"
        default 51
        help
            PHY_RSTN of the board; IP101 pin 32. app_eth.c pulses it low
            before the first SMI transaction so the chip-ID check during
            esp_eth_driver_install() cannot fail on a PHY held in reset.

    config EB_ETH_PHY_ADDR
        int "IP101 SMI address"
        default 1
        range 0 31
        help
            The board pulls PHY_AD0 high, so the PHY answers at SMI
            address 1 (verified on the schematic).

    config EB_TOUCH_I2C_PORT
        int "Touch I2C port"
        default 1

    config EB_TOUCH_I2C_SCL
        int "Touch I2C SCL GPIO"
        default 6
        help
            The touch controller of the board is not documented; the
            driver probes GT911 (0x5D/0x14), FT5x06 (0x38) and CST816
            (0x15) on this bus. Verify pins against the board schematic.

    config EB_TOUCH_I2C_SDA
        int "Touch I2C SDA GPIO"
        default 5

    config EB_TOUCH_SWAP_XY
        bool "Touch: swap X/Y"
        default n

    config EB_TOUCH_MIRROR_X
        bool "Touch: mirror X"
        default n

    config EB_TOUCH_MIRROR_Y
        bool "Touch: mirror Y"
        default n

    choice EB_SEARCH_ENGINE
        prompt "Search engine"
        default EB_ENGINE_DUCKDUCKGO
        help
            DuckDuckGo HTML endpoint has a stable markup and no consent
            wall. Google markup changes often and may serve captcha to
            datacenter IPs; it is best-effort.

        config EB_ENGINE_DUCKDUCKGO
            bool "DuckDuckGo (html endpoint)"

        config EB_ENGINE_GOOGLE
            bool "Google (best-effort)"
    endchoice

    config EB_MAX_BODY_KB
        int "Max HTTP body size (KB)"
        default 384
        range 64 1024

endmenu

menu "Example Boards Types"

    choice
        prompt "Choose the Boards Types"
        default BOARD_TYPE_JC4880P443
            config BOARD_TYPE_JC4880P443
                bool "JC4880P4433"

            config BOARD_TYPE_JC8012P4A1
                bool "JC8012P4A1"
            config BOARD_TYPE_JC1060P470
                bool "JC1060P470"
    endchoice

endmenu
