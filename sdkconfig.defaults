# ESP-IDF 5.5.x / 6.0.x — JC1060P470C_I_W_Y camera photo app
# Board: ESP32-P4 rev v1.3 + OV02C10 + JD9165 1024x600
# Recommended: ESP-IDF 5.5.5 (proven ~30 fps).
# IDF 6.0.3: components/ содержит cam_sensor 1.2.1 + адаптированные esp_video/esp_ipa/esp_lcd_jd9365
#
CONFIG_IDF_TARGET="esp32p4"

CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
# CONFIG_ESP32P4_REV_MIN_300 is not set
# CONFIG_ESP32P4_REV_MIN_301 is not set
# CONFIG_ESP_FORCE_400MHZ_ON_REV_LESS_V3 is not set

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# На платах JC1060P470C стоит flash-чип Boya (видно в boot-логе:
# "Detected boya flash chip but using generic driver") — включаем родной драйвер
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

CONFIG_EXAMPLE_MIPI_CSI_SCCB_I2C_SCL_PIN=8
CONFIG_EXAMPLE_MIPI_CSI_SCCB_I2C_SDA_PIN=7
CONFIG_BOARD_TYPE_JC1060P470=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_HOOK_IP6_INPUT_NONE=y

CONFIG_CAMERA_OV02C10=y
CONFIG_CAMERA_OV02C10_AUTO_DETECT=y
CONFIG_CAMERA_OV02C10_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
# Режим сенсора по умолчанию (безопасный 720p). Для полных 2 MP выберите
# CONFIG_CAMERA_OV02C10_MIPI_RAW10_1920x1080_30FPS (+ см. docs/OV02C10_CAPABILITIES.md):
# menuconfig -> Camera Sensors Support -> OV02C10 -> Default format select
CONFIG_CAMERA_OV02C10_MIPI_RAW10_1288x728_30FPS=y
# CONFIG_CAMERA_OV02C10_MIPI_RAW10_1920x1080_30FPS is not set
# CONFIG_CAMERA_OV02C10_ISP_AF_ENABLE is not set
CONFIG_CAMERA_OV02C10_DEFAULT_IPA_JSON_CONFIGURATION_FILE=y

# --- Новые опции ветки ov02c10-full-capability (docs/OV02C10_CAPABILITIES.md) ---
# Тестовый шаблон сенсора: 0=выкл, 1-4=типы цветных полос
CONFIG_EXAMPLE_CAM_TEST_PATTERN=0
# Переопределение fps: 0=дефолт режима (30), 1-30=ниже (VBLANK/VTS, длиннее экспозиция)
CONFIG_EXAMPLE_CAM_TARGET_FPS=0
# Вывод на LCD: кроп по центру 1:1 (макс. резкость) или вписать весь кадр (letterbox)
CONFIG_EXAMPLE_CAM_DISPLAY_FIT_CROP=y

CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# CONFIG_PM_ENABLE is not set
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
