# ESP-IDF 6.0.x — JC1060P470C CamBrowser (Ethernet web browser, camera removed)
# Board: ESP32-P4 rev v1.3 + JD9165 1024x600 + IP101 PHY on the internal EMAC
# (RMII: MDC 31 / MDIO 52, REF_CLK in 50, RSTN 51, SMI addr 1; no W5500 on
# the board). The camera stack (esp_video / esp_cam_sensor / esp_ipa /
# OV02C10) lives in the feature/camos branch only; this branch carries no
# camera options.
#
CONFIG_IDF_TARGET="esp32p4"

CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
# CONFIG_ESP32P4_REV_MIN_300 is not set
# CONFIG_ESP32P4_REV_MIN_301 is not set
# CONFIG_ESP_FORCE_400MHZ_ON_REV_LESS_V3 is not set

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# На платах JC1060P470C стоит flash-чип Boya (видно в boot-логе:
# "Detected boya flash chip but using generic driver") — включаем родной драйвер
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

CONFIG_BOARD_TYPE_JC1060P470=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_HOOK_IP6_INPUT_NONE=y

# --- Ethernet: IP101 PHY on the internal EMAC (RMII) ---
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_PHY_INTERFACE_RMII=y

# --- Тачскрин (GT911 на шине бывшей камеры SCCB) ---
# Пины проверены отладкой v2 на реальной плате: контроллер висит на шине
# бывшего SCCB сенсора (SCL=8 / SDA=7), порт 1. Без аппаратного сброса
# (RST=GPIO5) GT911 не отвечает на I2C вообще - см. main/camos/touch.c.
# INT не подключён (-1): адрес 0x5D/0x14 перебирается при пробе.
CONFIG_EB_TOUCH_I2C_PORT=1
CONFIG_EB_TOUCH_I2C_SCL=8
CONFIG_EB_TOUCH_I2C_SDA=7
CONFIG_EB_TOUCH_RST_GPIO=5
CONFIG_EB_TOUCH_INT_GPIO=-1
# Ориентация тача 1024x600 (landscape) корректна "как есть":
# CONFIG_EB_TOUCH_SWAP_XY is not set
# CONFIG_EB_TOUCH_MIRROR_X is not set
# CONFIG_EB_TOUCH_MIRROR_Y is not set

# CONFIG_PM_ENABLE is not set
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

# --- Диагностика/защита ---
# Уровень логов: INFO по умолчанию (DEBUG захламляет лог сотнями строк
# MSPI DQS/MSPI Timing при каждом старте), DEBUG доступен через menuconfig:
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
#
# Структуры VFS принудительно во внутренней RAM (защита от порчи в PSRAM):
CONFIG_VFS_SELECT_INRAM=y
#
# Полное «отравление» кучи: canary вокруг каждого блока, abort с адресом
# при попытке malloc/free затёртого блока — ранний индикатор порчи памяти:
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
